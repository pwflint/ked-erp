# Copy to .env beside docker-compose.yml and fill in. Never commit .env.

# Image tag: the full commit SHA the KED image workflow built.
KED_IMAGE_TAG=

# 64 random hex characters: openssl rand -hex 32
JWT_SECRET=

# External database (Neon): the direct, non-pooled connection string.
# Leave empty to use the bundled Postgres (docker compose --profile local-db up -d).
DATABASE_URL=

# Bundled Postgres password, used only with the local-db profile.
POSTGRES_PASSWORD=

# Optional
# KED_PORT=8080
# KED_MEMORY_LIMIT=3g
# ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
